# ap-emp-ai — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# (CLAUDE.md hard rule 7). Values here are placeholders and defaults only —
# never paste a real key into this file.
#
# Variables are grouped by the phase that first needs them, so anything below
# your current phase can stay empty.

# ─── App ─────────────────────────────────────────────────────────────────────
# Used for absolute URLs in metadata, OG images and bot webhook registration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Phase 0) ──────────────────────────────────────────────────────
# `pnpm db:start` prints the local URL and keys. The anon key is public by
# design and is safe in the browser — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS entirely: ingestion pipeline, admin queue and
# bot webhooks. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations and the schema smoke test.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Ingestion / scrapers (Phase 1) ──────────────────────────────────────────
# A real, monitored address. It goes into the User-Agent on every request to a
# government site, and it is how an administrator reaches us if our crawler
# misbehaves — being contactable is the price of being allowed to crawl.
# Required before scraper A runs (CLAUDE.md hard rule 3).
SCRAPER_CONTACT_EMAIL=

# Sent as: ap-emp-ai-bot (contact: $SCRAPER_CONTACT_EMAIL)
# Politeness floor: 1 request per 2 seconds. Do not lower it.
SCRAPER_MIN_DELAY_MS=2000

# Where downloaded PDFs land before they are hashed and queued.
INGEST_DOWNLOAD_DIR=.downloads

# Shared secret for the nightly cron endpoints, so only the scheduler can
# trigger a scrape.
CRON_SECRET=

# Interim gate for /admin until Phase 6 adds real auth: requests must present
# this token. Long and random; rotate when admins change.
ADMIN_TOKEN=

# ─── Embeddings (Phase 1) ────────────────────────────────────────────────────
# openai | bge
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# MUST stay 1024: chunks.embedding is vector(1024). text-embedding-3-large is
# 3072-d natively, so the API call has to request 1024 dimensions explicitly.
# Changing this means a new migration and re-embedding the whole corpus.
EMBEDDING_DIMENSIONS=1024

OPENAI_API_KEY=
# Only when EMBEDDING_PROVIDER=bge (BGE-M3 via DeepInfra).
DEEPINFRA_API_KEY=

# ─── Answer LLM (Phase 2) ────────────────────────────────────────────────────
# gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# ─── Telegram bot (Phase 4) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Verifies inbound webhook calls really come from Telegram. Required: the
# webhook refuses to serve without it rather than accepting anonymous POSTs.
TELEGRAM_WEBHOOK_SECRET=

# Channels the bot monitors for posted GOs, comma-separated (@username or id).
# An allow-list, not "anything the bot can see": a bot can be added to any
# channel, and without this a stranger could bury the review queue in junk.
# Empty means monitor nothing, so forgetting to set it fails closed.
TELEGRAM_MONITOR_CHANNELS=

# ─── WhatsApp Cloud API (Phase 4) ────────────────────────────────────────────
# Official Cloud API only — no Baileys/whatsapp-web.js (CLAUDE.md hard rule 4).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Echoed back during Meta's webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=
# Validates the X-Hub-Signature-256 header on inbound webhooks. Required: the
# webhook refuses to serve without it rather than accepting anonymous POSTs.
WHATSAPP_APP_SECRET=

# ─── Error tracking (Phase 6.4) ──────────────────────────────────────────────
# Optional. With no DSN, Sentry never initialises: no network calls, and the
# client SDK stays out of the initial bundle (it is imported dynamically behind
# this check). Errors then go to the server log, as they did before.
# Personal data is stripped before any report is sent — see
# apps/web/src/lib/observability/scrub.ts — and /privacy discloses the service.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Only needed to upload source maps at deploy time, so stack traces are readable
# rather than minified. Without all three, the build skips upload entirely.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
