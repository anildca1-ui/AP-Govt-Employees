{
  "name": "ap-emp-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Telugu-first portal, RAG chatbot and calculator suite for AP government employees",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "node scripts/build-packages.mjs && pnpm --filter @ap-emp-ai/web dev",
    "packages:build": "node scripts/build-packages.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "rates:worksheet": "node scripts/rates-worksheet.mjs",
    "rates:generate": "node scripts/generate-rates-seed.mjs",
    "test": "node scripts/build-packages.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/build-packages.mjs && pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .next .turbo",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/001_schema_smoke.sql",
    "db:schema-check": "./scripts/schema-check.sh",
    "verify:footer": "node scripts/verify-footer.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "verify:calculators": "node scripts/verify-calculators.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify:all": "./scripts/verify-all.sh",
    "dev:fake-db": "node scripts/fake-supabase.mjs",
    "dev:fake-models": "node scripts/fake-model-apis.mjs",
    "eval": "pnpm --filter @ap-emp-ai/rag eval",
    "gate": "./scripts/gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.22",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "supabase": "^2.111.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vitest": "^4.1.10"
  }
}
