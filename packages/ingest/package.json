{
  "name": "@ap-emp-ai/ingest",
  "version": "0.0.0",
  "private": true,
  "description": "Scrapers and the PDF ingestion pipeline (PLAN.md Part 2.1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:selectors": "pnpm build && node --env-file-if-exists=../../.env dist/cli/verify-selectors.js",
    "scrape:goir": "pnpm build && node --env-file-if-exists=../../.env dist/cli/scrape-goir.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "playwright": "^1.62.1",
    "robots-parser": "^3.0.1"
  }
}
