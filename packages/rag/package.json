{
  "name": "@ap-emp-ai/rag",
  "version": "0.0.0",
  "private": true,
  "description": "Hybrid retrieval and grounded answering over the GO corpus (PLAN.md Part 2)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "pnpm build && node --env-file-if-exists=../../.env dist/eval/run-eval.js"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
